{
	"name": "rss-discord",
	"version": "2.0.0",
	"type": "module",
	"scripts": {
		"dev": "bun src/cli.ts",
		"start": "bun src/cli.ts",
		"build": "bun build src/cli.ts --target=bun --outdir=dist",
		"migrate:config": "bun scripts/migrate-config-json-to-env.ts",
		"typecheck": "tsc",
		"lint": "biome check .",
		"format": "biome check --write --unsafe .",
		"test": "bun test --coverage"
	},
	"license": "MIT",
	"dependencies": {
		"rss-parser": "^3.13.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/bun": "^1.3.14",
		"@yuu1111/biome-config": "^1.0.4",
		"@yuu1111/tsconfig": "^1.0.4",
		"typescript": "^7.0.2"
	}
}
